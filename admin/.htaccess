# Admin panel — no rewriting, no indexing, lock down includes.
DirectoryIndex index.php
Options -Indexes
RewriteEngine Off

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Frame-Options "DENY"
</IfModule>

# Never serve the include folder directly
RedirectMatch 404 ^/admin/inc/
